# Bật rewrite engine
RewriteEngine On

# Thiết lập base directory
RewriteBase /

# ===== Bảo vệ thư mục/file nhạy cảm =====
# Chặn truy cập trực tiếp vào config, database, docs nội bộ, file giải nén tạm
RewriteRule ^(config|database|temp_docx|docs)(/|$) - [F,L]

# Chặn các script tiện ích/seed/debug ở webroot (chỉ chạy qua CLI)
RewriteRule ^(chk|test_seed|teacher_seed|assign_all|seed_evaluations|fix_class_duplicates|fetch_literary_covers|apply_literary.*)\.php$ - [F,L]

# Chặn thực thi PHP trong thư mục uploads
RewriteRule ^uploads/.*\.(php|phtml|php[0-9])$ - [F,L]

# Chặn file cấu hình/dữ liệu ở thư mục gốc lộ ra ngoài (out.json, Plan.md, *.docx...)
RewriteRule ^[^/]+\.(sql|md|docx|zip|log|json|txt)$ - [F,L]

# ===== Routing =====
# Cho phép truy cập file tĩnh (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Chuyển tất cả request còn lại về index.php
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
